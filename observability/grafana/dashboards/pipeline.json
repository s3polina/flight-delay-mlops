{
  "uid": "flight-pipeline",
  "title": "Конвейер MLOps",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "templating": {"list": [{"name": "service", "type": "query", "datasource": {"type": "loki", "uid": "loki"}, "query": {"type": 1, "label": "service"}, "refresh": 2, "multi": true, "includeAll": true, "allValue": ".+"}]},
  "panels": [
    {"id": 1, "title": "Глубина рабочей очереди", "type": "timeseries", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "short", "custom": {"thresholdsStyle": {"mode": "line"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 100}]}}, "overrides": []}, "targets": [{"expr": "rabbitmq_detailed_queue_messages_ready{queue=\"flight.tasks\"}", "legendFormat": "Очередь", "refId": "A"}, {"expr": "vector(100)", "legendFormat": "Лимит", "refId": "B"}]},
    {"id": 2, "title": "Источник и воркеры: задач/с", "type": "timeseries", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "ops"}}, "targets": [{"expr": "sum(rate(source_tasks_published_total[1m]))", "legendFormat": "Источник", "refId": "A"}, {"expr": "sum(rate(worker_tasks_processed_total{result=\"ok\"}[1m]))", "legendFormat": "Все воркеры", "refId": "B"}, {"expr": "sum by (service_instance_id) (rate(worker_tasks_processed_total{result=\"ok\"}[1m]))", "legendFormat": "{{service_instance_id}}", "refId": "C"}]},
    {"id": 3, "title": "Inference p50 / p95 / p99", "type": "timeseries", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "s"}}, "targets": [{"expr": "histogram_quantile(0.50, sum by (le) (rate(worker_inference_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A"}, {"expr": "histogram_quantile(0.95, sum by (le) (rate(worker_inference_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B"}, {"expr": "histogram_quantile(0.99, sum by (le) (rate(worker_inference_duration_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "C"}]},
    {"id": 4, "title": "API p50 / p95 / p99", "type": "timeseries", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "s"}}, "targets": [{"expr": "histogram_quantile(0.50, sum by (le) (rate(api_request_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A"}, {"expr": "histogram_quantile(0.95, sum by (le) (rate(api_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B"}, {"expr": "histogram_quantile(0.99, sum by (le) (rate(api_request_duration_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "C"}]},
    {"id": 5, "title": "Ответы HTTP 503, %", "type": "timeseries", "gridPos": {"x": 0, "y": 16, "w": 8, "h": 7}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "percent"}}, "targets": [{"expr": "100 * sum(rate(api_overloaded_responses_total[5m])) / clamp_min(sum(rate(api_requests_total[5m])), 0.001)", "refId": "A"}]},
    {"id": 6, "title": "Отказы публикации / секунду", "type": "timeseries", "gridPos": {"x": 8, "y": 16, "w": 8, "h": 7}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "ops"}}, "targets": [{"expr": "sum(rate(source_broker_rejections_total[1m]))", "refId": "A"}]},
    {"id": 7, "title": "Сообщения в DLQ", "type": "timeseries", "gridPos": {"x": 16, "y": 16, "w": 8, "h": 7}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "short"}}, "targets": [{"expr": "rabbitmq_detailed_queue_messages_ready{queue=~\".*dlq.*|.*dead.*\"}", "refId": "A"}]},
    {"id": 8, "title": "Память процессов (RSS)", "type": "timeseries", "gridPos": {"x": 0, "y": 23, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "bytes"}}, "targets": [{"expr": "process_memory_rss_bytes", "legendFormat": "{{service_name}} {{service_instance_id}}", "refId": "A"}]},
    {"id": 9, "title": "Последние ошибки", "type": "logs", "gridPos": {"x": 12, "y": 23, "w": 12, "h": 7}, "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"expr": "{service=~\"$service\",level=~\"ERROR|error|WARNING|warning\"}", "refId": "A"}], "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true}}
  ]
}
